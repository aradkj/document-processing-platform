# Application Configuration
APP_NAME="Document Processing Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (Development / Docker)
# For local machine access when running PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docplatform
# Inside Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/docplatform

# Database Connection Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# PostgreSQL Container Credentials (used by Docker Compose)
# WARNING: Default credentials are for local development convenience only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docplatform
POSTGRES_PORT=5432

# Email Verification & SMTP Configuration
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@docplatform.local
SMTP_FROM_NAME="Document Processing Platform"
FRONTEND_BASE_URL=http://localhost:3000

# Password Reset Configuration
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# JWT & Authentication Configuration
# WARNING: In production (APP_ENV=production), JWT_SECRET_KEY must be a cryptographically
# secure random string of at least 32 characters, and cannot use the development default.
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=docplatform
JWT_AUDIENCE=docplatform-api

# Storage Configuration (Phase 3.1)
STORAGE_BACKEND=local
# Local development storage root directory:
STORAGE_LOCAL_ROOT=./storage_data
# Inside Docker Compose, set to mounted volume:
# STORAGE_LOCAL_ROOT=/app/storage_data
# Streaming chunk size in bytes (default: 1048576 = 1 MiB)
STORAGE_CHUNK_SIZE=1048576



